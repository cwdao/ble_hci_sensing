          <mxGeometry x="880" y="36" width="100" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_loc" value="S_local(f)&lt;br&gt;━━╱╲━━━━" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="panel_c">
          <mxGeometry x="1000" y="36" width="90" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_pha" value="S_phase(f)&lt;br&gt;━━━╱╲━━━" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="panel_c">
          <mxGeometry x="1110" y="36" width="90" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="e_c0" edge="1" parent="1" source="cs_frames" target="preprocess" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;">
