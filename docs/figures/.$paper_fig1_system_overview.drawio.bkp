        </mxCell>

        <mxCell id="l1" value="&lt;b&gt;L1: tone align (72 → 1 per modal)&lt;/b&gt;&lt;br&gt;Hilbert continuous phase + coherence gating&lt;br&gt;→ y_remote(t), y_local(t), y_phase(t)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;dashed=1;dashPattern=8 4;strokeWidth=2;fontSize=10;align=left;spacingLeft=6;" vertex="1" parent="branch2b">
