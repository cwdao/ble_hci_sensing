        <mxCell id="stage1" value="&lt;b&gt;Stage 1: Per-Modal η·ρ Voting (§3.3)&lt;/b&gt;&lt;br&gt;&lt;i&gt;shared front-end&lt;/i&gt;&lt;br&gt;72 tones → quality weights → weighted spectrum per modal&lt;br&gt;→ S_remote(f), S_local(f), S_phase(f) + confidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="panel_c">
