        <mxCell id="e_2a" edge="1" parent="1" source="eq_fuse" target="out_bpm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeColor=#82b366;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry"/>
