        </mxCell>

        <mxCell id="eq_fuse" value="&lt;b&gt;Equal-weight fusion (1:1:1)&lt;/b&gt;&lt;br&gt;S_final = (S_rem + S_loc + S_pha) / 3&lt;br&gt;→ parabolic peak interp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="branch2a">
