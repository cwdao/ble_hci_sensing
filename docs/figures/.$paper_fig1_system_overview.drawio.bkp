        <mxCell id="panel_d" value="(d) Design principles" style="swimlane;startSize=26;fillColor=#fafafa;strokeColor=#666666;fontStyle=1;html=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="916" width="1220" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="⚖ &lt;b&gt;Quality-driven&lt;/b&gt;&lt;br&gt;η·ρ per-tone per-window&lt;br&gt;→ no hardcoded preference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=10;verticalAlign=middle;" vertex="1" parent="panel_d">
          <mxGeometry x="20" y="40" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p2" value="⚖ &lt;b&gt;Physically symmetric&lt;/b&gt;&lt;br&gt;remote / local / phase&lt;br&gt;1:1:1 equal treatment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;fontSize=10;verticalAlign=middle;" vertex="1" parent="panel_d">
          <mxGeometry x="260" y="40" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p3" value="◎ &lt;b&gt;Continuous phase&lt;/b&gt;&lt;br&gt;Hilbert rotation (≠ time shift)&lt;br&gt;→ no edge artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=10;verticalAlign=middle;" vertex="1" parent="panel_d">
          <mxGeometry x="500" y="40" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p4" value="👤 &lt;b&gt;Per-window estimation&lt;/b&gt;&lt;br&gt;modal align adapts to&lt;br&gt;multipath changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontSize=10;verticalAlign=middle;" vertex="1" parent="panel_d">
          <mxGeometry x="740" y="40" width="220" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="p5" value="🛡 &lt;b&gt;Robust &amp; general&lt;/b&gt;&lt;br&gt;principles hold across&lt;br&gt;scenarios and hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;fontSize=10;verticalAlign=middle;" vertex="1" parent="panel_d">
