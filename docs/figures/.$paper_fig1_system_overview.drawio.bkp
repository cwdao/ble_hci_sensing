        <mxCell id="e_s1_2a" edge="1" parent="1" source="stage1" target="branch2a" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;strokeWidth=2;strokeColor=#82b366;">
