          <mxGeometry x="40" y="150" width="400" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="branch2b" value="Stage 2b: Waveform Branch (§3.5) — Two-level Hilbert-MRC" style="swimlane;startSize=24;fillColor=#fff3e0;strokeColor=#d79b00;fontStyle=1;html=1;fontSize=11;" vertex="1" parent="panel_c">
